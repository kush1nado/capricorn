#!/bin/sh
# Capricorn pre-commit: версия поднята, тесты зелёные.
# Подключение (один раз на клон): git config core.hooksPath .githooks
cd "$(git rev-parse --show-toplevel)" || exit 1

if [ -x .venv/Scripts/python.exe ]; then PY=.venv/Scripts/python.exe
elif [ -x .venv/bin/python ]; then PY=.venv/bin/python
else PY=python
fi

"$PY" scripts/version.py check || exit 1
"$PY" -m pytest -q -p no:cacheprovider || { echo "pre-commit: тесты не прошли" >&2; exit 1; }
